generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  fullName           String
  role               UserRole  @default(BUSINESS_OWNER)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  business           Business? @relation("BusinessOwner")
  sessions           Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Business {
  id                String                @id @default(cuid())
  name              String
  phone             String?
  isActive          Boolean               @default(true)
  ownerId           String                @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  currencyUnit      CurrencyUnit          @default(TOMAN)
  nextInvoiceNumber BigInt                @default(1000)
  owner             User                  @relation("BusinessOwner", fields: [ownerId], references: [id])
  contacts          Contact[]
  expenses          Expense[]
  movements         InventoryMovement[]
  invoices          Invoice[]
  payments          Payment[]
  products          Product[]
  priceChanges      ProductPriceHistory[]
  backorders        Backorder[]
  purchaseReturns   PurchaseReturn[]
  salesReturns      SalesReturn[]
}

model Category {
  id         String    @id @default(cuid())
  businessId String
  name       String
  products   Product[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id                  String                @id @default(cuid())
  businessId          String
  categoryId          String?
  name                String
  sku                 String?
  unit                String                @default("عدد")
  averageCost         Decimal               @default(0) @db.Decimal(30, 9)
  inventoryValue      BigInt                @default(0)
  purchasePrice       BigInt                @default(0)
  salePrice           BigInt                @default(0)
  stock               Decimal               @default(0) @db.Decimal(18, 3)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  barcode             String?
  isActive            Boolean               @default(true)
  minStock            Decimal               @default(0) @db.Decimal(18, 3)
  movements           InventoryMovement[]
  invoiceItems        InvoiceItem[]
  purchaseReturnItems PurchaseReturnItem[]
  salesReturnItems    SalesReturnItem[]
  priceHistory        ProductPriceHistory[]
  backorders          Backorder[]
  business            Business              @relation(fields: [businessId], references: [id])
  category            Category?             @relation(fields: [categoryId], references: [id])

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@unique([id, businessId])
  @@index([businessId, name])
  @@index([businessId, isActive, name])
}

model Contact {
  id          String      @id @default(cuid())
  businessId  String
  name        String
  type        ContactType @default(BOTH)
  phone       String?
  email       String?
  address     String?
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business Business  @relation(fields: [businessId], references: [id])
  invoices Invoice[]
  payments Payment[]

  @@index([businessId, name])
  @@index([businessId, type, isActive])
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model Invoice {
  id                     String              @id @default(cuid())
  businessId             String
  idempotencyKey         String?
  idempotencyRequestHash String?
  contactId              String?
  type                   InvoiceType
  status                 InvoiceStatus       @default(DRAFT)
  invoiceNumber          String
  subtotal               BigInt              @default(0)
  extraCosts             BigInt              @default(0)
  discount               BigInt              @default(0)
  discountPercent        Decimal?            @db.Decimal(5, 2)
  reference              String?
  referenceNumber        String?
  total                  BigInt              @default(0)
  description            String?
  invoiceDate            DateTime            @default(now())
  issuedAt               DateTime?
  costingRecordedAt      DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  movements              InventoryMovement[]
  business               Business            @relation(fields: [businessId], references: [id])
  contact                Contact?            @relation(fields: [contactId], references: [id])
  items                  InvoiceItem[]
  payments               Payment[]
  revisions              InvoiceRevision[]
  backorders             Backorder[]
  purchaseReturns        PurchaseReturn[]
  salesReturns           SalesReturn[]
  contactNameSnapshot    String?
  contactPhoneSnapshot   String?
  contactAddressSnapshot String?
  paymentPlanRecorded    Boolean             @default(false)

  @@unique([businessId, invoiceNumber])
  @@unique([businessId, idempotencyKey])
  @@unique([id, businessId])
  @@index([businessId, type, createdAt])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  productId String
  quantity  Decimal @db.Decimal(18, 3)
  unitPrice BigInt
  total     BigInt

  costOfGoodsSold BigInt  @default(0)
  costedQuantity  Decimal @default(0) @db.Decimal(18, 3)

  invoice         Invoice              @relation(fields: [invoiceId], references: [id])
  product         Product              @relation(fields: [productId], references: [id])
  backorder       Backorder?
  purchaseReturns PurchaseReturnItem[]
  salesReturns    SalesReturnItem[]

  @@unique([id, invoiceId, productId])
}

model Expense {
  id           String          @id @default(cuid())
  businessId   String
  title        String
  category     ExpenseCategory @default(OTHER)
  amount       BigInt
  method       PaymentMethod   @default(CASH)
  status       ExpenseStatus   @default(CONFIRMED)
  description  String?
  spentAt      DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  cancelledAt  DateTime?
  cancelReason String?

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, spentAt])
  @@index([businessId, category, spentAt])
  @@index([businessId, status, spentAt])
}

enum ExpenseCategory {
  RENT
  SALARY
  TRANSPORT
  UTILITIES
  ADVERTISING
  MAINTENANCE
  TAX
  OTHER
}

enum ExpenseStatus {
  CONFIRMED
  CANCELLED
}

model InventoryMovement {
  id               String       @id @default(cuid())
  businessId       String
  productId        String
  invoiceId        String?
  purchaseReturnId String?
  salesReturnId    String?
  type             MovementType
  quantity         Decimal      @db.Decimal(18, 3)

  totalCost BigInt @default(0)

  averageCost Decimal  @default(0) @db.Decimal(30, 9)
  description String?
  createdAt   DateTime @default(now())

  business             Business              @relation(fields: [businessId], references: [id])
  invoice              Invoice?              @relation(fields: [invoiceId], references: [id])
  purchaseReturn       PurchaseReturn?       @relation(fields: [purchaseReturnId], references: [id])
  salesReturn          SalesReturn?          @relation(fields: [salesReturnId, businessId], references: [id, businessId], onDelete: Restrict)
  product              Product               @relation(fields: [productId], references: [id])
  backorderAllocations BackorderAllocation[]

  @@index([businessId, productId, createdAt])
  @@index([salesReturnId])
}

model Payment {
  id                String  @id @default(cuid())
  businessId        String
  contactId         String?
  invoiceId         String?
  purchaseReturnId  String?
  salesReturnId     String?
  allocationBatchId String?

  type   PaymentType
  method PaymentMethod
  status PaymentStatus @default(CONFIRMED)

  amount             BigInt
  trackingNumber     String?
  description        String?
  checkNumber        String?
  checkIssuedAt      DateTime?
  checkDueAt         DateTime?
  checkClearedAt     DateTime?
  payableTo          String?
  destinationDetails String?

  paidAt       DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cancelledAt  DateTime?
  cancelReason String?

  business       Business        @relation(fields: [businessId], references: [id])
  contact        Contact?        @relation(fields: [contactId], references: [id])
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id])
  purchaseReturn PurchaseReturn? @relation(fields: [purchaseReturnId], references: [id])
  salesReturn    SalesReturn?    @relation(fields: [salesReturnId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, paidAt])
  @@index([businessId, contactId, paidAt])
  @@index([businessId, invoiceId])
  @@index([businessId, status, paidAt])
  @@index([businessId, purchaseReturnId])
  @@index([businessId, salesReturnId])
  @@index([invoiceId, allocationBatchId, status])
}

enum PaymentMethod {
  CASH
  POS
  CARD_TO_CARD
  BANK_TRANSFER
  CHECK
  LEDGER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum InvoiceType {
  PURCHASE
  SALE
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  INITIAL_STOCK
}

enum PaymentType {
  RECEIPT
  PAYMENT
}

enum CurrencyUnit {
  RIAL
  TOMAN
}

model ProductPriceHistory {
  id                  String            @id @default(cuid())
  businessId          String
  productId           String
  field               ProductPriceField
  oldPrice            BigInt
  newPrice            BigInt
  increaseBasisPoints Int
  createdAt           DateTime          @default(now())
  business            Business          @relation(fields: [businessId], references: [id])
  product             Product           @relation(fields: [productId], references: [id])

  @@index([businessId, createdAt])
  @@index([productId, createdAt])
}

enum ProductPriceField {
  PURCHASE
  SALE
}

model InvoiceRevision {
  id        String   @id @default(cuid())
  invoiceId String
  editorId  String
  before    Json
  after     Json
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
}

model Backorder {
  id                String                @id @default(cuid())
  businessId        String
  invoiceId         String
  invoiceItemId     String?               @unique
  productId         String
  requested         Decimal               @db.Decimal(18, 3)
  fulfilled         Decimal               @default(0) @db.Decimal(18, 3)
  outstanding       Decimal               @db.Decimal(18, 3)
  inventoryDeducted Boolean               @default(false)
  cancelledAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  business          Business              @relation(fields: [businessId], references: [id])
  invoice           Invoice               @relation(fields: [invoiceId], references: [id])
  invoiceItem       InvoiceItem?          @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  product           Product               @relation(fields: [productId], references: [id])
  allocations       BackorderAllocation[]

  @@index([businessId, productId, outstanding])
  @@index([invoiceId])
}

model BackorderAllocation {
  id                  String             @id @default(cuid())
  backorderId         String
  quantity            Decimal            @db.Decimal(18, 3)
  totalCost           BigInt             @default(0)
  inventoryMovementId String?
  createdAt           DateTime           @default(now())
  backorder           Backorder          @relation(fields: [backorderId], references: [id], onDelete: Cascade)
  inventoryMovement   InventoryMovement? @relation(fields: [inventoryMovementId], references: [id], onDelete: SetNull)

  @@index([backorderId, createdAt])
  @@index([inventoryMovementId])
}

model PurchaseReturn {
  id                     String               @id @default(cuid())
  businessId             String
  invoiceId              String
  returnNumber           String
  total                  BigInt
  description            String?
  idempotencyKey         String?
  idempotencyRequestHash String?
  createdAt              DateTime             @default(now())
  business               Business             @relation(fields: [businessId], references: [id])
  invoice                Invoice              @relation(fields: [invoiceId], references: [id])
  items                  PurchaseReturnItem[]
  payments               Payment[]
  movements              InventoryMovement[]

  @@unique([businessId, returnNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, invoiceId, createdAt])
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  purchaseReturnId String
  invoiceItemId    String
  productId        String
  quantity         Decimal        @db.Decimal(18, 3)
  amount           BigInt
  inventoryCost    BigInt
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  invoiceItem      InvoiceItem    @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)
  product          Product        @relation(fields: [productId], references: [id])

  @@index([purchaseReturnId])
  @@index([invoiceItemId])
}

model SalesReturn {
  id                     String              @id @default(cuid())
  businessId             String
  invoiceId              String
  returnNumber           String
  total                  BigInt
  description            String?
  idempotencyKey         String?
  idempotencyRequestHash String?
  createdAt              DateTime            @default(now())
  business               Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  invoice                Invoice             @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Restrict)
  items                  SalesReturnItem[]
  payments               Payment[]
  movements              InventoryMovement[]

  @@unique([businessId, returnNumber])
  @@unique([businessId, idempotencyKey])
  @@unique([id, businessId])
  @@unique([id, businessId, invoiceId])
  @@index([businessId, invoiceId, createdAt])
}

model SalesReturnItem {
  id            String      @id @default(cuid())
  businessId    String
  invoiceId     String
  salesReturnId String
  invoiceItemId String
  productId     String
  quantity      Decimal     @db.Decimal(18, 3)
  amount        BigInt
  inventoryCost BigInt
  salesReturn   SalesReturn @relation(fields: [salesReturnId, businessId, invoiceId], references: [id, businessId, invoiceId], onDelete: Restrict)
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId, invoiceId, productId], references: [id, invoiceId, productId], onDelete: Restrict)
  product       Product     @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([salesReturnId])
  @@index([invoiceItemId])
}
